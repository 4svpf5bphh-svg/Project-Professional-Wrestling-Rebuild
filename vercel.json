{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run web:build",
  "outputDirectory": "dist/web",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "rewrites": [
    {
      "source": "/api/profile",
      "destination": "/api/identity?route=profile"
    },
    {
      "source": "/api/promotion-identity",
      "destination": "/api/identity?route=promotion-identity"
    },
    {
      "source": "/api/media-scrum",
      "destination": "/api/identity?route=media-scrum"
    }
  ]
}
